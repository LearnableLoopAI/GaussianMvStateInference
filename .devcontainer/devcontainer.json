// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/JuliaLang/devcontainer-templates/tree/main/src/julia
{
	"name": "Julia",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",

	// Register Jupyter kernels: Julia 1.10.0 (default) and Julia 1.10.5 (v4 notebook).
	"postCreateCommand": "julia -e 'using Pkg; Pkg.add(\"IJulia\")' && julia +1.10.5 -e 'using Pkg; Pkg.add(\"IJulia\"); using IJulia; installkernel(\"Julia 1.10.5\"; specname=\"julia-1.10.5\")' && julia -e 'p=expanduser(\"~/.local/share/jupyter/kernels/julia-1.10.5/kernel.json\"); write(p, replace(read(p, String), \"Julia 1.10.5 1.10\" => \"Julia 1.10.5\"))'",

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		// A Feature to install Julia via juliaup. More info: https://github.com/JuliaLang/devcontainer-features/tree/main/src/julia.
		"ghcr.io/julialang/devcontainer-features/julia:1": {
			// "channel": "release" //Julia version
			"channel": "1.10.0", // default Julia version
			"additionalChannels": "1.10.5" // extra kernel for GaussianMvStateInference_BLOG^v4.ipynb
		}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"julialang.language-julia",
				"ms-toolsai.jupyter"
			]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
